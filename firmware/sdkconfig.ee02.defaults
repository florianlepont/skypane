# Modified from FlightPortrait (github.com/flightportrait/frame) for
# SkyPane; the changes are listed in firmware/VENDOR.md.
#
# Unit B board profile (XIAO EE02 + ESP32-S3 Plus), layered on top of
# sdkconfig.defaults (firmware/build.sh). Verified on hardware, see below.

# --- Identity ---
# Reported to the server; without it, Unit B inherits sdkconfig.defaults'
# "proto-e1004" and misreports itself in the fleet record.
CONFIG_FP_HW_REV="proto-ee02"

# --- Panel pins (six of eight signals differ from the E1004) ---
# Source: Seeed_GFX User_Setups/EPaper_Board_Pins_Setups.h (its `// D7`/
# `// D8` comments are stale; numeric values are authoritative). Verified
# on hardware, hardware/BRINGUP-LOG.md "Board Profile Verification"
# (2026-08-25).
CONFIG_FP_PIN_EPD_SCK=7
CONFIG_FP_PIN_EPD_MOSI=9
CONFIG_FP_PIN_EPD_CS_M=44
CONFIG_FP_PIN_EPD_CS_S=41
CONFIG_FP_PIN_EPD_DC=10
CONFIG_FP_PIN_EPD_RST=38
CONFIG_FP_PIN_EPD_BUSY=4
CONFIG_FP_PIN_EPD_EN=43

# CS_M=44 and EN=43 are UART0 RX/TX on this SoC; console output must
# route to USB Serial/JTAG here or it will drive chip-select/panel
# power. The EE02's XIAO exposes native USB-Serial/JTAG, so this costs
# nothing.
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_ESP_CONSOLE_UART_DEFAULT=n

# --- Controls (override needed: E1004's KEY1=GPIO4 clashes with BUSY) ---
# Hardware-verified 2026-07-26: printed KEY1/KEY2/KEY3 -> GPIO2/GPIO3/
# GPIO5. No silkscreen role semantics (unlike the E1004's icons), so
# main/Kconfig.projbuild's FP_PIN_KEY0/1/2 role choice is a decision.

# Chosen by blast radius: KEY0 (admin, ten-second hold = DESTRUCTIVE
# FACTORY RESET) got the last-tried button (printed KEY3), so a stray
# long-press elsewhere cannot wipe the frame. The enclosure's plungers
# must follow this exact mapping, not the E1004's.
CONFIG_FP_PIN_KEY0=5
CONFIG_FP_PIN_KEY1=3
CONFIG_FP_PIN_KEY2=2

# --- Battery sense ---
# Sourced from Seeed's own EE0x driver-board cookbook, whose applicability
# banner covers EE02/EE03/EE04/EE05 while its worked example names EE04
# specifically, so this project treats the ratio as inherited rather
# than a value read directly off this exact board's schematic.

# CONFIRMED ON THIS BOARD: hardware/BRINGUP-LOG.md's "ADC Battery-Sense
# Bring-Up" flash-and-observe check promoted these from an inherited
# claim to measured hardware fact on first flash, no correction needed.
CONFIG_FP_PIN_BATTERY_ADC=1
CONFIG_FP_PIN_BATTERY_ADC_EN=6

# --- Bring-up LED (built-in User LED) ---
# Sourced from web aggregation of Seeed community and board-reference
# material, not an official schematic, unlike the panel pins above.

# NOT YET CONFIRMED ON THIS BOARD. A flash-and-observe check
# (hardware/BRINGUP-LOG.md "User LED Bring-Up (GPIO21)") is the gate
# that promotes this from an inherited claim to measured hardware fact.
CONFIG_FP_PIN_LED=21
CONFIG_FP_LED_ACTIVE_LOW=y
