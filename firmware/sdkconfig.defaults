# Modified from FlightPortrait (github.com/flightportrait/frame) for
# SkyPane; the changes are listed in firmware/VENDOR.md.
CONFIG_IDF_TARGET="esp32s3"

CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y

# 960 KB framebuffer lives in PSRAM (XIAO ESP32-S3 Plus: octal/OPI PSRAM).
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y

# The bootloader boots a new OTA image on trial and automatically falls
# back to the previous one unless the app explicitly marks it valid after
# a successful poll. This is a bootloader option: it only takes effect
# after a USB flash of a bootloader built with this Kconfig, never
# through OTA itself (OTA can never rewrite the bootloader or `factory`).
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y

# Signed-app verification without hardware secure boot: the frame refuses
# an OTA image whose signature does not match the public key embedded in
# the signature block of the currently-running app. Confirmed in the
# pinned espressif/idf:v5.3.1 container (firmware/SIGNING.md, "Resolved
# configuration") that this reads and writes no eFuse -- the trust anchor
# is the running app's own signature block, not hardware-locked key
# storage, and CONFIG_SECURE_BOOT/CONFIG_SECURE_FLASH_ENC_ENABLED/
# CONFIG_NVS_ENCRYPTION/CONFIG_BOOTLOADER_APP_ANTI_ROLLBACK all resolve as
# not set. CI signs every release out of band with `espsecure.py
# sign_data --version 2` using a GitHub Actions secret key, so
# CONFIG_SECURE_BOOT_BUILD_SIGNED_BINARIES stays off and the private key
# never touches a build machine (firmware/SIGNING.md).
CONFIG_SECURE_SIGNED_APPS_NO_SECURE_BOOT=y
CONFIG_SECURE_SIGNED_ON_UPDATE_NO_SECURE_BOOT=y
CONFIG_SECURE_SIGNED_APPS_RSA_SCHEME=y
# CONFIG_SECURE_BOOT_BUILD_SIGNED_BINARIES is not set

# The task watchdog is a hang detector: it panics when a subscribed task
# stops feeding it for 60 s (the Kconfig maximum), and the next boot sees
# a task-WDT reset and backs off. The whole-wake budget is
# CONFIG_SKYPANE_WAKE_BUDGET_S, a separate timer.
CONFIG_ESP_TASK_WDT_INIT=y
CONFIG_ESP_TASK_WDT_TIMEOUT_S=60
CONFIG_ESP_TASK_WDT_PANIC=y

# The full-memory test costs ~0.45 s on every wake.
CONFIG_SPIRAM_MEMTEST=n

# DHCP was ~3.0 s of a ~4.4 s no-change wake; re-requesting the last lease
# and skipping the ARP probe is the cheapest cut.
CONFIG_LWIP_DHCP_RESTORE_LAST_IP=y
CONFIG_LWIP_DHCP_DOES_ARP_CHECK=n

# Trust only the ISRG roots behind the VPS's Let's Encrypt certificate; if
# Let's Encrypt ever moves to a root not in this directory, a certificate
# change ships as an ordinary signed release over OTA -- there is no
# separate CA-update channel, since the bundle is compiled into the app
# image like everything else.
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE_DEFAULT_NONE=y
CONFIG_MBEDTLS_CUSTOM_CERTIFICATE_BUNDLE=y
CONFIG_MBEDTLS_CUSTOM_CERTIFICATE_BUNDLE_PATH="main/certs"

# Needed to keep one TLS session per wake and resume it across deep sleep.
CONFIG_ESP_TLS_CLIENT_SESSION_TICKETS=y
CONFIG_ESP_HTTP_CLIENT_ENABLE_CUSTOM_TRANSPORT=y

# The synchronous state machine runs polling and JSON parsing on
# app_main, nesting buffers inside the ESP-IDF TLS/HTTP client.
# ESP-IDF's 3584-byte default overflows during that path; keep explicit
# headroom (upstream: FlightPortrait README "Building").
CONFIG_ESP_MAIN_TASK_STACK_SIZE=12288

# FlightPortrait project settings, kept as upstream defaults; the EE02
# profile (sdkconfig.ee02.defaults) overrides them with Unit B's own
# values. Do not hand-edit the pin values here -- that keeps Unit A reproducible.
CONFIG_FP_HW_REV="proto-e1004"
CONFIG_FP_PIN_EPD_SCK=7
CONFIG_FP_PIN_EPD_MOSI=9
CONFIG_FP_PIN_EPD_CS_M=10
CONFIG_FP_PIN_EPD_CS_S=2
CONFIG_FP_PIN_EPD_DC=11
CONFIG_FP_PIN_EPD_RST=38
CONFIG_FP_PIN_EPD_BUSY=13
CONFIG_FP_PIN_EPD_EN=12
CONFIG_FP_PIN_KEY0=3
CONFIG_FP_PIN_KEY1=4
CONFIG_FP_PIN_KEY2=5
CONFIG_FP_REPROVISION_HOLD_MS=2000
CONFIG_FP_FACTORY_RESET_HOLD_MS=10000

# This build implements no BLE provisioning - hardcoded credentials in a
# gitignored secrets.h replace it for a device that talks only to a
# local stub. Carrying the BLE/NimBLE stack would inflate the image for
# no benefit here.
CONFIG_BT_ENABLED=n
CONFIG_BT_NIMBLE_ENABLED=n
