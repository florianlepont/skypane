# Repo-root .gitignore. The six existing per-subdirectory .gitignore
# files (deploy/, server/, firmware/, stub-server/, adsb-test/,
# server/state/) each cover their own directory only — this file is
# strictly additive, closing gaps those files don't reach.

# --- OS cruft the subdir files do not reach ---
# macOS Finder metadata can appear at any depth.
.DS_Store

# --- Python artifacts at repo-root scope ---
# server/.gitignore already covers server/.venv/ and server/__pycache__/;
# these catch the same patterns elsewhere in the tree.
__pycache__/
*.pyc
.venv/

# --- Symlinked venv ---
# A no-trailing-slash pattern, since server/.venv/ (trailing slash, in
# server/.gitignore) only matches a real directory, not a symlinked venv
# (used by some worktree bootstraps) — this catches it by name either way.
/server/.venv

# --- Tooling caches ---
# Landed here before ruff/coverage/pytest ever run, so no cache file is
# ever in git history.
.ruff_cache/
.coverage
.coverage.*
.pytest_cache/

# --- ESP-IDF build output at root scope ---
# firmware/.gitignore covers build*/ relative to firmware/; this catches
# the same pattern invoked from the repo root.
firmware/build*/

# --- Agent/worktree scratch ---
# A nested checkout under .claude/worktrees/ must never be stageable from
# the root — it pins objects as reachable, and is agent scratch, not
# project content.
.claude/worktrees/

# --- Credential belt-and-suspenders ---
# Duplicates deploy/.gitignore and firmware/.gitignore's rules here too,
# so a repo-root `git add -A` can never stage a real credential.
deploy/skypane.env
firmware/main/secrets.h

# --- Local planning scratch ---
# Cached research API responses, not needed to reconstruct any planning
# artifact.
.planning/research/.cache/
