# Issued bearer tokens persisted by byos_server.py - never enter git.
byos_state.json

# _atomic_write's unique-name temp files (every writer, not just one fixed name).
*.tmp

# Generated panel binaries (960 KB each; make_test_panel.py regenerates on demand).
*.bin

# Content-addressed published panel images: img/<sha256>.bin.
img/

# Python bytecode caches.
__pycache__/
*.pyc
