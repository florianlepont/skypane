[Unit]
Description=SkyPane companion configuration web interface (companion/app.py)
# Caddy is the only thing that should reach this (deploy/Caddyfile
# reverse-proxies 127.0.0.1:${SKYPANE_COMPANION_PORT}; provision.sh's ufw
# denies it from outside). This process also binds 127.0.0.1 itself
# (--bind), so loopback is enforced twice over.
#
# No systemd IP address allow-list filter here: this service makes its
# own outbound calls (calendar ICS fetch, ntfy, /poll-now), and systemd's
# IP filtering directives apply to both directions.
#
# Separate service from skypane-byos (device protocol) and skypane-poll
# (ADS-B render loop): a failure or restart here cannot take down either.
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=skypane
Group=skypane
EnvironmentFile=/opt/skypane/skypane.env
WorkingDirectory=/opt/skypane
ExecStart=/opt/skypane/venv/bin/python3 /opt/skypane/current/companion/app.py \
    --port ${SKYPANE_COMPANION_PORT} \
    --state-dir ${SKYPANE_STATE_DIR} \
    --geofence /opt/skypane/current/adsb-test/runway3.json \
    --bind 127.0.0.1
Restart=always
RestartSec=5

# Hardening: /opt/skypane/current is the only place this runs from.
# ReadWritePaths is scoped to state/ only; UMask=0027 matches its setgid
# mode. ProtectProc=invisible hides every user's argv; AF_UNIX stays open
# for NSS/resolver lookups the outbound calls need.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/skypane/state
CapabilityBoundingSet=
AmbientCapabilities=
PrivateDevices=true
DevicePolicy=closed
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
SystemCallArchitectures=native
MemoryDenyWriteExecute=true
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
UMask=0027

[Install]
WantedBy=multi-user.target
