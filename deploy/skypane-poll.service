[Unit]
Description=SkyPane poll cycle (detect -> infer -> enrich -> render -> atomic swap)
# Triggered by skypane-poll.timer every 30s. A failing cycle doesn't stop
# the timer (systemd's default: a failed oneshot doesn't disable it) --
# the error goes to journald and the previously rendered panel.bin keeps
# being served by skypane-byos.service.
#
# No systemd IP address allow-list filter here: this process calls the
# ADS-B providers on every cycle.
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
# A oneshot's default start timeout is infinity, so one trickling upstream
# (or a stuck lock wait) could otherwise hang a cycle forever. Every
# outbound call this cycle makes is itself bounded (deadline + one read
# timeout), a normal cycle finishes in a few seconds, and the worst
# legitimate case (every upstream at its own limit) stays under a minute --
# 90s leaves headroom without masking a genuinely stuck process. A cycle
# killed at this timeout leaves no torn state file: every write in this
# codebase is atomic (temp file + rename) and any held flock is released
# with the process.
TimeoutStartSec=90s
User=skypane
Group=skypane
EnvironmentFile=/opt/skypane/skypane.env
WorkingDirectory=/opt/skypane
ExecStart=/opt/skypane/venv/bin/python3 /opt/skypane/current/server/poll_loop.py \
    --once \
    --state-dir ${SKYPANE_STATE_DIR} \
    --geofence /opt/skypane/current/adsb-test/runway3.json \
    --caddy-log ${SKYPANE_CADDY_ACCESS_LOG}

# Hardening: same posture as skypane-byos.service/skypane-companion.service
# (see their own comments) -- release-layout code path only, ReadWritePaths
# scoped to state/, UMask=0027 matches its setgid mode, ProtectProc=invisible
# hides this service's argv.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/skypane/state
CapabilityBoundingSet=
AmbientCapabilities=
PrivateDevices=true
DevicePolicy=closed
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
SystemCallArchitectures=native
MemoryDenyWriteExecute=true
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
UMask=0027
