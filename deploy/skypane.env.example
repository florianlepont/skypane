# SkyPane -- production env template.
#
# Copy this file to `deploy/skypane.env` ON THE VPS ONLY (never in this
# repo, never committed) and fill in the real values there. Never paste
# its contents into a log, issue or chat transcript.
#
# systemd reads it as root via `EnvironmentFile=` before each unit drops
# to its own `User=`. `deploy/provision.sh` sets the real file to
# `root:root 0600`; no service reads it directly as the `skypane` user.

# Device enrolment secrets are no longer stored here: each frame has its
# own per-device secret, registered on this VPS as a SHA-256 hash via
# stub-server/devices_cli.py (see deploy/README.md). A stray
# SKYPANE_BYOS_SECRET=... line is harmless and can be deleted.

# Loopback port byos_server.py listens on. Caddy reverse-proxies to it;
# ufw denies external access (deploy/provision.sh). Not secret.
SKYPANE_BYOS_PORT=8642

# Fallback sleep_s (seconds) sent to the frame between polls, used until
# the companion Settings page sets a per-device value. Not secret.
SKYPANE_SLEEP_S=30

# Directory holding panel.bin / poll_state.json / enrichment cache.
# skypane-poll.service and skypane-byos.service must agree on this path.
# Not secret.
SKYPANE_STATE_DIR=/opt/skypane/state

# Public hostname the device polls, e.g. a nip.io host (deploy/Caddyfile)
# or an owned domain. Operator convenience only; Caddy reads the real
# hostname from deploy/Caddyfile. Not secret.
SKYPANE_PUBLIC_HOST=203-0-113-10.nip.io

# Shared password gating the companion web interface (no per-user
# accounts). Generate with `openssl rand -hex 32`. Secret: never commit
# a real value; this file keeps only the placeholder.
SKYPANE_COMPANION_PASSWORD=replace-with-a-long-random-secret

# Loopback port companion/app.py listens on, proxied and firewalled the
# same way as SKYPANE_BYOS_PORT above. Not secret.
SKYPANE_COMPANION_PORT=8643

# Public hostname for the companion interface, distinct from
# SKYPANE_PUBLIC_HOST so each service gets its own TLS certificate.
# Operator convenience only. Not secret.
SKYPANE_COMPANION_HOST=config-203-0-113-10.nip.io

# Drops the Secure flag on companion cookies. NEVER set in production --
# only for a plain-http LAN/dev run with no TLS in front. Fails closed:
# only the exact value `1` disables Secure. Leave commented out on the
# VPS.
# SKYPANE_COMPANION_INSECURE_COOKIES=1

# Path to Caddy's JSON access log for the device-protocol site block.
# The companion service tails this file for device battery telemetry
# (X-Battery-Mv); byos_server.py itself persists nothing. Not secret.
SKYPANE_CADDY_ACCESS_LOG=/opt/skypane/state/caddy-access.log

# Path to the off-box backup freshness marker, written by
# deploy/backup/backup_gate.py's `ack` verb after each successful pull.
# Unset hides the companion Health page's backup-age line. Not secret.
SKYPANE_OFFBOX_MARKER=/var/lib/skypane-backup/pulled/last-pull
