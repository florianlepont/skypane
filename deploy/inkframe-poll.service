[Unit]
Description=Ink Frame poll cycle (detect -> infer -> enrich -> render -> atomic swap)
# Triggered by inkframe-poll.timer every 30s. A failing cycle must not stop
# the timer from firing again - systemd's default behaviour (a failed
# oneshot unit does not disable its triggering timer) already gives us
# this for free; the error just goes to journald and the previously
# rendered panel.bin keeps being served by inkframe-byos.service.
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=inkframe
Group=inkframe
EnvironmentFile=/opt/inkframe/inkframe.env
WorkingDirectory=/opt/inkframe
ExecStart=/opt/inkframe/venv/bin/python3 /opt/inkframe/server/poll_loop.py \
    --once \
    --state-dir ${INK_STATE_DIR}

# Hardening - same posture as inkframe-byos.service.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/inkframe/state
