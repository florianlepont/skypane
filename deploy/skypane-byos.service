[Unit]
Description=SkyPane BYOS device-protocol server (stub-server/byos_server.py)
# Caddy is the only thing that should reach this (deploy/Caddyfile
# reverse-proxies 127.0.0.1:${SKYPANE_BYOS_PORT}; provision.sh's ufw
# denies it from outside). byos_server.py itself binds 0.0.0.0 (known
# vendored behaviour, deploy/README.md); loopback is enforced there instead.
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=skypane
Group=skypane
EnvironmentFile=/opt/skypane/skypane.env
WorkingDirectory=/opt/skypane
ExecStart=/opt/skypane/venv/bin/python3 /opt/skypane/current/stub-server/byos_server.py \
    --image ${SKYPANE_STATE_DIR}/panel.bin \
    --port ${SKYPANE_BYOS_PORT} \
    --sleep ${SKYPANE_SLEEP_S} \
    --state-dir ${SKYPANE_STATE_DIR} \
    --image-url-scheme https
Restart=always
RestartSec=5

# Hardening: /opt/skypane/current is the only place this runs from.
# ReadWritePaths is scoped to state/ only; UMask=0027 matches its setgid
# mode. ProtectProc=invisible hides every user's argv; AF_UNIX stays open
# for the NSS/resolver lookups this HTTP server needs.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/skypane/state
CapabilityBoundingSet=
AmbientCapabilities=
PrivateDevices=true
DevicePolicy=closed
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
SystemCallArchitectures=native
MemoryDenyWriteExecute=true
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
UMask=0027

[Install]
WantedBy=multi-user.target
