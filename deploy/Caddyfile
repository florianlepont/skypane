# SkyPane -- Caddy reverse proxy + automatic HTTPS.
#
# Renders /etc/caddy/sites/skypane.caddy (deploy/render_caddyfile.sh, via
# deploy/activate.sh); the host Caddyfile imports it, so keep to site
# blocks only, no global options block (host-file-only in Caddy).
#
# Hostnames are <dashed-vps-ip>.nip.io, resolved to the embedded IP with
# no DNS zone needed, for the Let's Encrypt HTTP-01 challenge.

203-0-113-10.nip.io {
    reverse_proxy 127.0.0.1:8642

    # HSTS is a browser policy, not read by the firmware (esp_http_client
    # never inspects response headers here). No `preload` (not submitted
    # to any preload list) and no `includeSubDomains` (no subdomains).
    header Strict-Transport-Security "max-age=31536000"

    # Durable per-request access log (not stdout, which is journald-bound
    # and rotates on its own schedule). The device's battery voltage
    # arrives as the X-Battery-Mv header; byos_server.py prints it but
    # persists nothing, so this file is the only durable record.
    #
    # Caddy's header redaction covers only Cookie/Set-Cookie/Authorization/
    # Proxy-Authorization, so telemetry headers appear here; the tailer
    # (server/history_db.py) reads an explicit four-name allowlist, never
    # the full header map, so a redaction change cannot leak a credential.
    log {
        output file /opt/skypane/state/caddy-access.log {
            # mode 660: caddy (owner) writes; server/poll_loop.py (user
            # skypane) reads every 30s via --caddy-log. provision.sh sets
            # setgid on state/ and adds caddy to group skypane, so 660
            # (not 640) lets caddy append via group membership too.
            mode 660
            # roll_size/roll_keep bound growth; the tailer resets its
            # stored offset when the file is shorter than that offset, so
            # rotation neither loses nor double-counts readings.
            roll_size 10MiB
            roll_keep 5
        }
        format json
    }
}

config-203-0-113-10.nip.io {
    # Compression for the browser-facing companion only: Caddy suffixes a
    # strong upstream ETag with the encoding and strips that suffix from
    # an incoming If-None-Match before proxying, so origin-side 304s keep
    # working through this layer. The device block above stays
    # uncompressed on purpose — the firmware's esp_http_client sends no
    # Accept-Encoding, and the device protocol is not touched here.
    encode zstd gzip

    reverse_proxy 127.0.0.1:8643

    # Same HSTS policy as the device block above: no preload, no
    # includeSubDomains.
    header Strict-Transport-Security "max-age=31536000"

    # Console log only: no durable-telemetry requirement here, just
    # operator convenience for `journalctl -u caddy`.
    log {
        output stdout
        format json
    }
}
